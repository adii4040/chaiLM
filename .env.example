# Server Environment
PORT=5000
NODE_ENV=development
CLIENT_URI=http://localhost:5173

# Database & Vector Store
MONGODB_URI=mongodb://localhost:27017/chailm
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=workspace-docs

# Inngest Background Tasks / Workflow Engine
# (Required for Inngest Cloud production; optional for local Inngest Dev Server)
INNGEST_EVENT_KEY=your_inngest_event_key_here
INNGEST_SIGNING_KEY=your_inngest_signing_key_here

# AI Provider Keys
OPENAI_API_KEY=your_openai_api_key_here
CHAT_MODEL=gpt-4o-mini
OUTLINE_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

GEMINI_API_KEY=your_gemini_api_key_here
COHERE_API_KEY=your_cohere_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Document & Ingestion APIs
TRANSCRIPT_API_KEY=your_transcript_api_key_here
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Authentication Secrets
ACCESS_TOKEN_SECRET_KEY=your_jwt_access_secret_key_here
REFRESH_TOKEN_SECRET_KEY=your_jwt_refresh_secret_key_here

# Chunking & Retrieval Parameters
CHUNK_SIZE=600
CHUNK_OVERLAP=150
VECTOR_TOP_K=10
FINAL_TOP_K=5
RRF_K=60
